# Режим работы: mock | webhook | oauth
# Если не задан — mock при отсутствии BITRIX_WEBHOOK_URL
BITRIX_MODE=mock

# Входящий вебхук Bitrix24 (dev / серверные запросы)
# Пример: https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/
BITRIX_WEBHOOK_URL=

# URL портала (для открытия задач). Если пусто — берётся из вебхука
BITRIX_PORTAL_URL=

# Публичный URL портала для клиента (опционально)
NEXT_PUBLIC_BITRIX_PORTAL_URL=

# Задел под OAuth локального приложения (несколько пользователей / встраивание)
BITRIX_OAUTH_CLIENT_ID=
BITRIX_OAUTH_CLIENT_SECRET=
BITRIX_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/callback
